# 複製這個檔案為 .env 並填入實際值
#   Windows:  copy .env.example .env
# .env 已列在 .gitignore，不會進版控

# Django 密鑰：隨機字串，每個環境都該不一樣
DJANGO_SECRET_KEY=請填入一組隨機字串

# 正式環境務必設成 False
DJANGO_DEBUG=True

# 逗號分隔，例如 127.0.0.1,example.com；DEBUG=True 時可留空
DJANGO_ALLOWED_HOSTS=

# MySQL 連線設定
DB_NAME=movie_db
DB_USER=root
DB_PASSWORD=請填入你的 MySQL 密碼
DB_HOST=localhost
DB_PORT=3306
